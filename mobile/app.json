{
  "expo": {
    "name": "WagerPals",
    "slug": "wagerpals",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "wagerpals",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wagerpals.app",
      "appleTeamId": "3C4383262W",
      "associatedDomains": [
        "applinks:wagerpals.io",
        "applinks:*.wagerpals.io"
      ],
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.wagerpals.app"],
        "keychain-access-groups": ["$(AppIdentifierPrefix)com.wagerpals.shared"]
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F9E56"
      },
      "package": "com.wagerpals.app",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "wagerpals.io",
              "pathPrefix": "/"
            },
            {
              "scheme": "https",
              "host": "*.wagerpals.io",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0F9E56",
          "sounds": []
        }
      ],
      [
        "./plugins/imessage-extension/withIMessageExtension",
        {
          "teamId": "3C4383262W",
          "appGroup": "group.com.wagerpals.app",
          "appStoreId": "6754625373",
          "webBaseUrl": "https://wagerpals.io"
        }
      ]
    ],
    "extra": {
      "apiUrl": "${EXPO_PUBLIC_API_URL}",
      "auth0Domain": "${EXPO_PUBLIC_AUTH0_DOMAIN}",
      "auth0ClientId": "${EXPO_PUBLIC_AUTH0_CLIENT_ID}",
      "appleTeamId": "3C4383262W",
      "keychainAccessGroup": "3C4383262W.com.wagerpals.shared",
      "keychainService": "wagerpals",
      "appGroup": "group.com.wagerpals.app",
      "eas": {
        "projectId": "749a2dc6-bdc5-44e4-907b-3c77e36bb760",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "WagerPalsMessages",
                  "bundleIdentifier": "com.wagerpals.app.messages",
                  "entitlements": {
                    "com.apple.security.application-groups": ["group.com.wagerpals.app"],
                    "keychain-access-groups": ["$(AppIdentifierPrefix)com.wagerpals.shared"]
                  }
                }
              ]
            }
          }
        }
      }
    },
    "owner": "birud"
  }
}
