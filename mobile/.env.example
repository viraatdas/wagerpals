# API Configuration
# For local development:
EXPO_PUBLIC_API_URL=http://localhost:3000

# For production (use your actual domain):
# EXPO_PUBLIC_API_URL=https://your-domain.vercel.app

# Stack Auth Configuration
# Get these from your Stack Auth dashboard: https://app.stack-auth.com
EXPO_PUBLIC_STACK_PROJECT_ID=your_stack_project_id
EXPO_PUBLIC_STACK_PUBLISHABLE_KEY=your_stack_publishable_key

# Push Notifications (Optional)
# EXPO_PUBLIC_PUSH_TOKEN=your_expo_push_token

# Native Google Sign-In (iOS)
# iOS OAuth client id from Google Cloud console (Credentials -> Create iOS
# client, bundle id com.wagerpals.app). MUST be set before prebuild/build:
#  - app.config.js reverses it into the iOS URL scheme
#  - src/services/auth.ts passes it to GoogleSignin.configure({ iosClientId })
# Also add it to the EAS build env (eas.json) for real builds.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_ios_oauth_client_id.apps.googleusercontent.com

# Optional: override the Web OAuth client id (defaults to the existing one in
# src/services/auth.ts). Public identifier, not a secret.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1084366774946-9t37qi8aaj3v3k69fnkggf7qq2egl0m3.apps.googleusercontent.com
