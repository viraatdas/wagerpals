# Database Configuration
POSTGRES_URL=your_postgres_url_here
POSTGRES_PRISMA_URL=your_postgres_prisma_url_here
POSTGRES_URL_NO_SSL=your_postgres_url_no_ssl_here
POSTGRES_URL_NON_POOLING=your_postgres_url_non_pooling_here
POSTGRES_USER=your_postgres_user_here
POSTGRES_HOST=your_postgres_host_here
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DATABASE=your_postgres_database_here

# Stack Auth Configuration
# Get these from your Stack Auth dashboard: https://app.stack-auth.com
NEXT_PUBLIC_STACK_PROJECT_ID=your_stack_project_id
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=your_stack_publishable_key
STACK_SECRET_SERVER_KEY=your_stack_secret_key

# App URL - CRITICAL for OAuth to work properly
# For local development: http://localhost:3000
# For production: https://wagerpals.io
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Web Push Notifications
# Generate keys with: npx web-push generate-vapid-keys
# ⚠️ IMPORTANT: The public key MUST have NEXT_PUBLIC_ prefix!
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_public_key_here
VAPID_PRIVATE_KEY=your_private_key_here
VAPID_SUBJECT=mailto:your-email@example.com

# Stripe (for real-money wallet)
# Get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Withdrawals are disabled by default (POST /api/wallet action=withdraw
# returns 503 PAYOUTS_UNAVAILABLE) because there is no real payout
# mechanism wired up yet — no Stripe Connect transfer, no external call of
# any kind. Setting this to the exact string "true" re-enables the
# withdraw endpoint, which will debit user wallet balances WITHOUT
# actually paying anyone. Do not enable in production until real payouts
# (e.g. Stripe Connect) are built.
WALLET_WITHDRAWALS_ENABLED=false

# iOS Universal Links
# Set your Apple Team ID and iOS bundle identifier so the
# apple-app-site-association file returns a valid appID.
APPLE_TEAM_ID=YOUR_APPLE_TEAM_ID
IOS_BUNDLE_IDENTIFIER=com.wagerpals.app

# Native iMessage extension
# HMAC key used to sign/verify share tokens so recipients of a wager's
# iMessage bubble can take a side without already being a group member.
# Generate with: openssl rand -base64 32
IMESSAGE_SHARE_SECRET=your_imessage_share_secret_here
